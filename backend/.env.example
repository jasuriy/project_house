# Copy to backend/.env for local development. Never commit the real .env.
DATABASE_URL=postgresql+asyncpg://prostagram:prostagram_dev@127.0.0.1:55433/prostagram

# Cloudflare R2 (an API token with "Object Read & Write" on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=projecthouse-images

# Optional: raises GitHub's limit from 60 to 5,000 requests per hour (no scopes needed)
GITHUB_API_TOKEN=
